{
  "expo": {
    "name": "Medicine Identifier",
    "slug": "medicine-identifier",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "This app uses the camera to photograph a medicine so it can identify it."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "This app needs access to your photos so you can choose a medicine photo from your gallery."
        }
      ]
    ]
  }
}
